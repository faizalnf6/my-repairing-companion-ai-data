Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://www.gnu.org/server/banners/fundraiser.css

@charset "utf-8";

div#top { border-top: 0px; }

#top p { margin: 0px; }

#fundraiser { background: rgb(0, 101, 255); position: relative; height: 230px; overflow: hidden; }

#fundraiser a { text-decoration: none; }

#fundraiser .progress { height: 18px; line-height: 18px; }

#fundraiser .progress-bar { background: rgb(253, 158, 56); position: absolute; min-width: 40px; top: 0px; left: 0px; }

#fundraiser .progress-bar span { position: relative; left: 10px; padding-left: 100%; white-space: nowrap; }

#fundraiser div.message { height: 200px; }

#fundraiser .message p.headline { padding: 10px; }

#fundraiser .message p.headline b { font-size: 30px; color: rgb(253, 158, 56); }

#fundraiser .message .button a { font-weight: bold; color: rgb(27, 12, 61); background: rgb(253, 158, 56); padding-bottom: 2px; display: inline; margin-left: 3em; }

#fundraiser .button a { border-radius: 20px; }

#fundraiser .message { margin: 5px; padding: 10px; background: rgb(27, 12, 61); text-align: center; }

